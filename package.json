{
  "name": "kronk-cli",
  "version": "0.3.0",
  "description": "A Claude-Code-style terminal agent for local models served by Kronk.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "kronk-cli": "./src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "kronk",
    "llm",
    "local",
    "agent",
    "cli",
    "qwen",
    "llama.cpp",
    "offline"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "changelog": "node scripts/changelog.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BardiaN/kronk-cli.git"
  },
  "bugs": {
    "url": "https://github.com/BardiaN/kronk-cli/issues"
  },
  "homepage": "https://github.com/BardiaN/kronk-cli#readme",
  "author": "Bardia Navvabian"
}
